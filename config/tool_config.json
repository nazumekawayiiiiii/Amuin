{
  "version": "2026-03-07",

  "common": {
    "urls": {
      "jobs_page": "https://www.zhipin.com/web/geek/jobs",
      "login_page": "https://www.zhipin.com/web/user/",
      "chat_page": "https://www.zhipin.com/web/geek/chat"
    },
    "popups": {
      "security_question": {
        "selector": ".dialog-wrap.dialog-account-safe",
        "close_selector": ".dialog-wrap.dialog-account-safe .close",
        "timeout_ms": 3000
      },
      "greet_boss_dialog": {
        "selector": ".greet-boss-dialog",
        "close_selector": ".greet-boss-dialog .greet-boss-footer .cancel-btn"
      },
      "chat_block_dialog": {
        "selector": ".chat-block-dialog",
        "confirm_selector": ".chat-block-dialog .chat-block-footer .sure-btn"
      }
    },
    "error_pages": [
      "https://www.zhipin.com/web/common/403.html",
      "https://www.zhipin.com/web/common/error.html",
      "https://www.zhipin.com/web/common/security-check.html"
    ],
    "captcha_page": "https://www.zhipin.com/web/user/safe/verify-slider"
  },

  "search_tool": {
    "url": "https://www.zhipin.com/web/geek/jobs",
    "elements": {
      "search_box": {
        "selector": ".c-search-input .search-input-box input",
        "fallback_selectors": [],
        "action_type": "input"
      },
      "recommend_tab": {
        "selector": ".c-expect-select a[ka=\"jobs_recommend_tab_click\"]",
        "fallback_selectors": [],
        "action_type": "click"
      }
    },
    "data_extracts": {
      "job_list": {
        "mount_selector": ".page-jobs-main",
        "path": "__vue__.jobList"
      },
      "has_more": {
        "mount_selector": ".page-jobs-main",
        "path": "__vue__.hasMore"
      },
      "current_query": {
        "mount_selector": ".page-jobs-main",
        "path": "__vue__.formData?.query"
      }
    },
    "api_endpoints": {
      "recommend_list": {
        "url_pattern": "wapi/zpgeek/pc/recommend/job/list.json",
        "purpose": "推荐职位列表加载"
      },
      "search_list": {
        "url_pattern": "wapi/zpgeek/search/joblist.json",
        "purpose": "搜索职位列表加载"
      }
    },
    "wait_selectors": {
      "job_list_container": ".job-list-container .rec-job-list",
      "job_empty": ".recommend-result-job .job-empty-wrapper",
      "loading": ".job-recommend-result .job-rec-loading"
    }
  },

  "filter_tool": {
    "elements": {
      "filter_bar": {
        "selector": ".page-jobs-main .filter-condition-inner",
        "action_type": "container"
      },
      "clear_all": {
        "selector": ".page-jobs-main .filter-condition-inner [ka=\"empty-filter\"]",
        "action_type": "click"
      },
      "city_button": {
        "selector": ".page-jobs-main .filter-condition-inner [ka=\"switch_city_dialog_open\"]",
        "action_type": "click"
      },
      "city_dialog": {
        "selector": ".city-select-dialog",
        "action_type": "container"
      },
      "city_hot_list": {
        "selector": ".city-select-dialog .city-select-wrapper ul.city-list-hot li",
        "action_type": "click"
      },
      "city_result_list": {
        "selector": ".city-select-dialog .city-select-wrapper .list-select-list a",
        "action_type": "click"
      },
      "header_logo": {
        "selector": "[ka=\"header-home-logo\"]",
        "action_type": "click"
      }
    },
    "ka_prefixes": {
      "city": "switch_city_dialog_open",
      "salary": "sel-job-rec-salary-",
      "experience": "sel-job-rec-exp-",
      "degree": "sel-job-rec-degree-",
      "industry": "sel-industry-",
      "scale": "sel-job-rec-scale-"
    },
    "filter_dropdown_vue": {
      "mount_selector": ".page-jobs-main .filter-condition-inner",
      "placeholders": ["城市", "薪资待遇", "工作经验", "学历要求", "公司行业", "公司规模"]
    }
  },

  "job_detail_tool": {
    "elements": {
      "job_cards": {
        "selector": "ul.rec-job-list li.job-card-box",
        "action_type": "click"
      },
      "detail_box": {
        "selector": ".job-detail-box",
        "action_type": "container"
      }
    },
    "data_extracts": {
      "job_detail": {
        "mount_selector": ".job-detail-box",
        "path": "__vue__.data"
      },
      "current_job": {
        "mount_selector": ".page-jobs-main",
        "path": "__vue__.currentJob"
      }
    },
    "api_endpoints": {
      "detail_loaded": {
        "url_pattern": "wapi/zpgeek/job/detail.json",
        "purpose": "职位详情加载完成"
      }
    }
  },

  "chat_tool": {
    "elements": {
      "chat_button": {
        "selector": ".job-detail-box .op-btn.op-btn-chat",
        "fallback_selectors": [],
        "action_type": "click",
        "expected_text": "立即沟通"
      },
      "chat_input": {
        "selector": ".chat-conversation .message-controls .chat-input",
        "action_type": "input"
      },
      "send_button": {
        "selector": ".chat-conversation .message-controls .chat-op .btn-send:not(.disabled)",
        "action_type": "click"
      }
    },
    "api_endpoints": {
      "add_friend": {
        "url_pattern": "wapi/zpgeek/friend/add.json",
        "purpose": "发起沟通"
      }
    },
    "response_codes": {
      "success": 0,
      "rate_limit_biz_code": 1,
      "daily_limit_text": "今日沟通人数已达上限，请明天再试"
    }
  },

  "mark_tool": {
    "elements": {
      "not_suitable_button": {
        "selector": ".job-detail-box .job-detail-operate .not-suitable",
        "action_type": "click"
      },
      "feedback_dialog": {
        "selector": ".zp-dialog-wrap.zp-feedback-dialog",
        "action_type": "container"
      },
      "feedback_confirm": {
        "selector": ".zp-dialog-footer .zp-btn.zp-btn-sure",
        "action_type": "click"
      },
      "feedback_close": {
        "selector": ".zp-close",
        "action_type": "click"
      }
    },
    "api_endpoints": {
      "reasons": {
        "url_pattern": "wapi/zpgeek/negativefeedback/reasons.json",
        "purpose": "获取不合适原因列表"
      },
      "save": {
        "url_pattern": "wapi/zpgeek/negativefeedback/save.json",
        "purpose": "保存不合适反馈"
      }
    },
    "reason_selectors": {
      "company": ".zp-type-item[title*=\"公司\"]",
      "interviewed": ".zp-type-item[title=\"面试过/入职过\"]",
      "duplicate": ".zp-type-item[title=\"重复推荐\"]",
      "distance": ".zp-type-item[title*=\"距离\"]",
      "salary": ".zp-type-item[title*=\"薪资\"]",
      "boss_inactive": ".zp-type-item[title=\"BOSS活跃度低\"]",
      "position_filled": ".zp-type-item[title=\"职位停招/招满\"]",
      "wrong_city": ".zp-type-item[title$=\"城市\"]",
      "wrong_position": ".zp-type-item[title$=\"职位\"]"
    }
  },

  "reply_tool": {
    "elements": {
      "chat_user_list": {
        "selector": ".main-wrap .chat-user",
        "action_type": "container"
      },
      "chat_list_items": {
        "selector": ".main-wrap .chat-user .user-list-content ul[role=group] li[role=listitem]",
        "action_type": "click"
      },
      "chat_input": {
        "selector": ".chat-conversation .message-controls .chat-input",
        "action_type": "input"
      },
      "send_button": {
        "selector": ".chat-conversation .message-controls .chat-op .btn-send:not(.disabled)",
        "action_type": "click"
      }
    },
    "data_extracts": {
      "friend_list": {
        "mount_selector": ".main-wrap .chat-user",
        "path": "__vue__.list"
      }
    },
    "api_endpoints": {
      "history_msg": {
        "url_pattern": "wapi/zpchat/geek/historyMsg",
        "purpose": "聊天记录加载"
      }
    }
  },

  "filter_codes": {
    "salary": {
      "不限": 0, "3K以下": 402, "3-5K": 403, "5-10K": 404,
      "10-20K": 405, "20-50K": 406, "50K以上": 407
    },
    "experience": {
      "不限": 0, "在校生": 108, "应届生": 102, "经验不限": 101,
      "1年以内": 103, "1-3年": 104, "3-5年": 105, "5-10年": 106, "10年以上": 107
    },
    "degree": {
      "不限": 0, "初中及以下": 209, "中专/中技": 208, "高中": 206,
      "大专": 202, "本科": 203, "硕士": 204, "博士": 205
    },
    "scale": {
      "不限": 0, "0-20人": 301, "20-99人": 302, "100-499人": 303,
      "500-999人": 304, "1000-9999人": 305, "10000人以上": 306
    },
    "industry": {
      "不限": 0,
      "互联网/AI": 100000, "电子/通信/半导体": 101400,
      "服务业": 101100, "消费品/批发/零售": 101000,
      "房地产/建筑": 100700, "教育培训": 100300,
      "广告/传媒/文化/体育": 100100, "制造业": 100900,
      "专业服务": 100600, "制药/医疗": 100400,
      "汽车": 100800, "交通运输/物流": 100500,
      "能源/化工/环保": 101200, "金融": 100200,
      "政府/非盈利/其他": 101300
    }
  },

  "active_levels": [
    "", "半年前活跃", "近半年活跃", "5月内活跃", "4月内活跃",
    "3月内活跃", "2月内活跃", "本月活跃", "2周内活跃", "本周活跃",
    "3日内活跃", "昨日活跃", "今日活跃", "刚刚活跃"
  ]
}
